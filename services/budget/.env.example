# Copier en .env et remplir les valeurs
# Ne JAMAIS committer .env dans Git

# PostgreSQL (srv-db : 192.168.56.12)
DB_NAME=budget
DB_USER=budget_user
DB_PASSWORD=
DB_HOST=192.168.56.12
DB_PORT=5432
DB_ENGINE=postgresql

# Redis (conteneur interne)
REDIS_URL=redis://redis:6379/0

# Django
SECRET_KEY=           # Générer avec : python -c "import secrets; print(secrets.token_hex(50))"
DEBUG=False
ALLOWED_HOSTS=budget.akanzair.com,192.168.56.11,localhost
