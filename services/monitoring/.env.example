# Copier en .env et remplir les valeurs
# Ne JAMAIS committer .env dans Git

# Portainer : mot de passe configuré via l'interface web au premier démarrage
# Pas de variable d'environnement — accès sur http://srv-app:9000

# Grafana admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Grafana SMTP (Gmail)
GMAIL_USER=
GMAIL_PASSWORD=              # Mot de passe d'application Gmail (pas le mot de passe Gmail normal)
